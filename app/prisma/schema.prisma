// Wasabi — Growth OS schema
// Source: pipeline/okara/spec/02-schema.md
// internal-first: no billing/credit models (see spec 00-prd.md out_of_scope)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- 認証 ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  chatThreads  ChatThread[]
  approvals    FeedCard[] @relation("ApprovedBy")
}

enum Role {
  ADMIN
  MEMBER
}

// ---------- プロジェクト ----------

model Project {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  url             String
  status          ProjectStatus @default(ANALYZING)
  languages       String[]      @default(["en", "ja"])
  phase           String        @default("prelaunch")
  cycleHours      Int           @default(6)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contextSources  ContextSource[]
  foundationDocs  FoundationDoc[]
  agentConfigs    AgentConfig[]
  feedCards       FeedCard[]
  integrations    Integration[]
  publishRecords  PublishRecord[]
  metricSnapshots MetricSnapshot[]
  weeklyReviews   WeeklyReview[]
  chatThreads     ChatThread[]
  jobRuns         JobRun[]
  siteAudits      SiteAudit[]
}

enum ProjectStatus {
  ANALYZING
  ACTIVE
  PAUSED
  FAILED
}

// ---------- Living Context Layer ----------

model ContextSource {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       ContextSourceKind
  config     Json
  enabled    Boolean           @default(true)
  lastSyncAt DateTime?
  lastDigest String?
  lastError  String?
  suggestion Json?
  snapshots  ContextSnapshot[]
}

enum ContextSourceKind {
  WEBSITE
  DOCUMENT
  GITHUB_REPO
  GSC
  GA
  USER_FEEDBACK
}

model ContextSnapshot {
  id          String        @id @default(cuid())
  sourceId    String
  source      ContextSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content     String
  contentMeta Json?
  createdAt   DateTime      @default(now())

  @@index([sourceId, createdAt])
}

// ---------- Foundation Documents ----------

model FoundationDoc {
  id        String                  @id @default(cuid())
  projectId String
  project   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      FoundationDocKind
  content   String
  version   Int                     @default(1)
  updatedBy String?
  updatedAt DateTime                @updatedAt
  history   FoundationDocRevision[]

  @@unique([projectId, kind])
}

enum FoundationDocKind {
  PRODUCT_DESCRIPTION
  PRODUCT_INFO
  MARKETING_STRATEGY
  COMPETITOR_ANALYSIS
  BRAND_VOICE
}

model FoundationDocRevision {
  id        String        @id @default(cuid())
  docId     String
  doc       FoundationDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  content   String
  version   Int
  updatedBy String?
  createdAt DateTime      @default(now())
}

// ---------- エージェント設定 ----------

model AgentConfig {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel      Channel
  enabled      Boolean @default(true)
  dailyQuota   Int     @default(1)
  instructions String?
  voiceProfile Json?
  config       Json?

  @@unique([projectId, channel])
}

enum Channel {
  X
  REDDIT
  SEO_GEO
  ARTICLE
  LAUNCH
  LINKEDIN
  TIKTOK
  ASO
}

// ---------- Agents Feed ----------

model FeedCard {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel       Channel
  type          String
  title         String
  status        CardStatus     @default(CURRENT)
  priority      Priority       @default(MEDIUM)
  difficulty    Difficulty     @default(EASY)
  language      String         @default("en")
  rationale     String?
  sourceRef     Json?
  archiveReason String?
  approvedById  String?
  approvedBy    User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime       @default(now())
  cycleId       String?
  drafts        Draft[]
  publishRecord PublishRecord?

  @@index([projectId, status, createdAt])
}

enum CardStatus {
  CURRENT
  DONE
  PUBLISHED
  ARCHIVED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ---------- ドラフト + 品質ゲート ----------

model Draft {
  id            String         @id @default(cuid())
  cardId        String
  card          FeedCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  version       Int            @default(1)
  content       String
  meta          Json?
  authorType    DraftAuthor    @default(AGENT)
  createdAt     DateTime       @default(now())
  qualityReview QualityReview?

  @@unique([cardId, version])
}

enum DraftAuthor {
  AGENT
  AGENT_FIX
  HUMAN
}

model QualityReview {
  id             String   @id @default(cuid())
  draftId        String   @unique
  draft          Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  genericScore   Int
  factualScore   Int
  voiceScore     Int
  communityScore Int?
  passed         Boolean
  critique       String
  createdAt      DateTime @default(now())
}

// ---------- 配信記録 + 成果ループ ----------

model PublishRecord {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cardId      String          @unique
  card        FeedCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  channel     Channel
  publishedAt DateTime        @default(now())
  externalUrl String?
  utm         String?
  method      PublishMethod
  outcomes    OutcomeMetric[]
}

enum PublishMethod {
  API_X
  GITHUB_PR
  CMS
  MANUAL
}

model OutcomeMetric {
  id         String        @id @default(cuid())
  recordId   String
  record     PublishRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  capturedAt DateTime      @default(now())
  metrics    Json
}

// ---------- サイト監査 ----------

model SiteAudit {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      AuditKind
  score     Int
  issues    Json
  stale     Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([projectId, kind, createdAt])
}

enum AuditKind {
  SEO
  GEO
}

// ---------- 外部指標スナップショット ----------

model MetricSnapshot {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    String
  date      DateTime
  metrics   Json
  createdAt DateTime @default(now())

  @@unique([projectId, source, date])
}

// ---------- 週次振り返り ----------

model WeeklyReview {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekStart DateTime
  content   String
  learnings Json?
  createdAt DateTime @default(now())

  @@unique([projectId, weekStart])
}

// ---------- 統合 ----------

model Integration {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      IntegrationKind
  status    IntegrationStatus @default(DISCONNECTED)
  label     String?
  config    Json?
  updatedAt DateTime          @updatedAt

  @@unique([projectId, kind])
}

enum IntegrationKind {
  X_OAUTH
  GITHUB_APP
  GSC
  GA
  CMS_WEBHOOK
  SLACK_WEBHOOK
  TELEGRAM_BOT
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// ---------- チャット ----------

model ChatThread {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id          String     @id @default(cuid())
  threadId    String
  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role        String
  content     String
  contextRefs Json?
  createdAt   DateTime   @default(now())
}

// ---------- ジョブ実行 ----------

model JobRun {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       JobKind
  status     JobStatus @default(RUNNING)
  log        String?
  attempt    Int       @default(1)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  @@index([projectId, kind, startedAt])
}

enum JobKind {
  ONBOARD_ANALYSIS
  CONTEXT_SYNC
  DAILY_CYCLE
  AUDIT
  METRIC_PULL
  WEEKLY_REVIEW
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}
