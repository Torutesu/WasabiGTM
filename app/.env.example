DATABASE_URL="postgresql://wasabi:wasabi@localhost:5432/wasabi?schema=public"

# Session signing key. Generate one: openssl rand -hex 32
AUTH_SECRET="change-me"

# Seed user (internal-first provisioning)
SEED_USER_EMAIL="founder@wasabi.local"
SEED_USER_PASSWORD="change-me"
SEED_USER_NAME="Founder"

# ---------------------------------------------------------------- LLM keys
# Set the key for whichever vendors you use. With WASABI_LLM_PROVIDER=auto the
# first vendor below that has a key is selected, in this order.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENCODE_API_KEY=""

# auto | anthropic | openai | gemini | opencode | offline
# `auto` falls back to `offline` when no key is set — fine for local work, but
# it means the app runs on deterministic fixtures rather than a real model.
WASABI_LLM_PROVIDER="auto"

# Optional endpoint overrides (proxies, self-hosted gateways, Azure, …)
# ANTHROPIC_BASE_URL=""
# OPENAI_BASE_URL=""
# OPENCODE_BASE_URL="https://opencode.ai/zen/v1"

# ------------------------------------------------------------- Model tiers
# Resolution order per tier: <PROVIDER>_MODEL_<TIER> → MODEL_<TIER> → built-in
# default for the active provider. Leave unset to use the defaults.
# MODEL_HIGH=""
# MODEL_MID=""
# MODEL_LIGHT=""
# OPENAI_MODEL_HIGH="gpt-5.6-sol"
# GEMINI_MODEL_HIGH="gemini-3.6-pro"
# OPENCODE_MODEL_HIGH="claude-opus-5"

# OpenCode Zen fronts a mixed catalogue, so it defaults to loose JSON mode and
# upgrades itself if the endpoint accepts strict schemas. Force it either way:
# OPENCODE_SCHEMA_MODE="json_schema"

# Mocks every outbound integration. Used by the E2E suite.
# NEVER set this in production.
# WASABI_MOCK_EXTERNAL="1"

# ------------------------------------------------------------- Public URL
# Used to build OAuth redirect URIs. Set it to the URL users actually browse to
# (a Cloudflare Tunnel hostname, workers.dev, your domain). Without it the app
# infers the origin from the request, which breaks behind some proxies.
APP_URL=""

# ---------------------------------------------------------------- X (Twitter)
# https://developer.x.com → your app → User authentication settings.
# Callback URL: <APP_URL>/api/integrations/x/callback
# Type: Web App (confidential) or Native App (public, no secret).
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# ------------------------------------------------- Google (Search Console/GA)
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth client
# (Web application). Enable the Search Console API and the Google Analytics
# Data + Admin APIs on the same project.
# Redirect URI: <APP_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------- GitHub
# Either register a GitHub App (Contents: read+write, Pull requests: read+write)
# with callback <APP_URL>/api/integrations/github/callback, or leave these unset
# and paste a fine-grained personal access token in the UI instead.
# The private key must be PKCS#8; convert GitHub's download once with:
#   openssl pkcs8 -topk8 -inform PEM -outform PEM -nocrypt -in key.pem -out key.pkcs8.pem
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""

# --------------------------------------------------------------- GEO probing
# Perplexity is the one AI search engine with an API that returns its citations,
# so it is what the GEO audit measures against. Unset means the audit reports
# "not measured" rather than guessing.
PERPLEXITY_API_KEY=""
# PERPLEXITY_MODEL="sonar"

# ----------------------------------------------------------------- Scheduler
# POST /api/cron/tick runs the next due job. Generate: openssl rand -hex 32
# Unset disables the endpoint entirely (503), so the loop only runs manually.
CRON_SECRET=""
# Intervals in hours. The daily cycle uses the project's own cycleHours setting.
# CRON_AUDIT_HOURS="24"
# CRON_METRIC_HOURS="6"
# CRON_REVIEW_HOURS="168"
